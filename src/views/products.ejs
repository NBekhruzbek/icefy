        </div>

        <!-- New Product Form Section -->
        <div class="form-section">
          <div class="section-header">
            <h2 class="new-dish-txt">Add New Product</h2>
          </div>

          <form
            action="/admin/product/create"
            method="POST"
            class="dish-container"
            enctype="multipart/form-data"
          >
            <!-- Basic Information -->
            <div class="form-group">
              <h3 class="form-group-title">Basic Information</h3>

              <div class="long-input">
                <label>Product Name *</label>
                <input
                  type="text"
                  placeholder="Enter product name"
                  name="productName"
                  class="product-name"
                  required
                />
              </div>

              <div class="long-input">
                <label>Product Description</label>
                <textarea
                  name="productDesc"
                  class="product-desc"
                  placeholder="Enter product description..."
                ></textarea>
              </div>

              <input
                name="productStatus"
                value="PAUSE"
                class="product-status"
                hidden
              />
            </div>

            <!-- Pricing & Stock -->
            <div class="form-group">
              <h3 class="form-group-title">Pricing & Stock</h3>

              <div class="half-input-frame">
                <div class="half-input">
                  <label>Original Price ($) *</label>
                  <input
                    type="number"
                    placeholder="0.00"
                    name="productPrice"
                    class="product-price"
                    step="0.01"
                    required
                  />
                </div>
                <div class="half-input">
                  <label
                    >Discount (%) <span class="optional">Optional</span></label
                  >
                  <input
                    type="number"
                    placeholder="0"
                    name="discountPercent"
                    class="discount-percent"
                    min="0"
                    max="100"
                    step="0.5"
                  />
                </div>
              </div>

              <div
                class="discount-preview-box"
                id="discountPreview"
                style="display: none"
              >
                <div class="discount-preview-item">
                  <span class="preview-label">Original Price:</span>
                  <span class="preview-value" id="previewOriginalPrice"
                    >$0.00</span
                  >
                </div>
                <div class="discount-preview-item">
                  <span class="preview-label">Discount:</span>
                  <span class="preview-value discount" id="previewDiscount"
                    >0%</span
                  >
                </div>
                <div class="discount-preview-item highlight">
                  <span class="preview-label">Final Price:</span>
                  <span class="preview-value final" id="previewFinalPrice"
                    >$0.00</span
                  >
                </div>
              </div>

              <div class="half-input-frame">
                <div class="half-input">
                  <label>Stock Count *</label>
                  <input
                    type="number"
                    placeholder="0"
                    name="productLeftCount"
                    class="product-left-count"
                    required
                  />
                </div>
              </div>
            </div>

            <!-- Product Details -->
            <div class="form-group">
              <h3 class="form-group-title">Product Details</h3>

              <div class="half-input-frame">
                <div class="half-input">
                  <label>Category *</label>
                  <select
                    class="product-category"
                    name="productCategory"
                    required
                  >
                    <option value="">Select Category</option>
                    <option value="CLASSIC">Classic</option>
                    <option value="PREMIUM">Premium</option>
                    <option value="LIMITED">Limited</option>
                    <option value="KIDS">Kids</option>
                    <option value="OTHER">Other</option>
                  </select>
                </div>

                <div class="half-input">
                  <label>Flavor *</label>
                  <select class="product-flavor" name="productFlavor" required>
                    <option value="">Select Flavor</option>
                    <option value="VANILLA">Vanilla</option>
                    <option value="CHOCOLATE">Chocolate</option>
                    <option value="STRAWBERRY">Strawberry</option>
                    <option value="COOKIES_CREAM">Cookies & Cream</option>
                    <option value="MANGO">Mango</option>
                    <option value="MATCHA">Matcha</option>
                    <option value="MINT_CHOCOLATE_CHIP">
                      Mint Chocolate Chip
                    </option>
                    <option value="COFFEE">Coffee</option>
                    <option value="CARAMEL">Caramel</option>
                    <option value="YOGURT">Yogurt</option>
                  </select>
                </div>
              </div>

              <div class="half-input-frame">
                <div class="half-input">
                  <label>Size *</label>
                  <select class="product-size" name="productSize" required>
                    <option value="">Select Size</option>
                    <option value="SMALL">Small</option>
                    <option value="MEDIUM">Medium</option>
                    <option value="LARGE">Large</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Product Images -->
            <div class="form-group">
              <h3 class="form-group-title">Product Images (Up to 5)</h3>

              <div class="img-frame">
                <div class="media-frame">
                  <div class="upload-img-box">
                    <img
                      src="/img/upload.png"
                      alt="Upload"
                      class="upload-placeholder"
                    />
                    <input
                      type="file"
                      name="productImages"
                      class="image-input"
                      required
                      accept="image/*"
                    />
                    <div class="image-preview" style="display: none">
                      <img class="preview-img" alt="Preview" />
                    </div>
                  </div>
                  <div class="upload-img-box">
                    <img
                      src="/img/upload.png"
                      alt="Upload"
                      class="upload-placeholder"
                    />
                    <input
                      type="file"
                      name="productImages"
                      class="image-input"
                      accept="image/*"
                    />
                    <div class="image-preview" style="display: none">
                      <img class="preview-img" alt="Preview" />
                    </div>
                  </div>
                  <div class="upload-img-box">
                    <img
                      src="/img/upload.png"
                      alt="Upload"
                      class="upload-placeholder"
                    />
                    <input
                      type="file"
                      name="productImages"
                      class="image-input"
                      accept="image/*"
                    />
                    <div class="image-preview" style="display: none">
                      <img class="preview-img" alt="Preview" />
                    </div>
                  </div>
                  <div class="upload-img-box">
                    <img
                      src="/img/upload.png"
                      alt="Upload"
                      class="upload-placeholder"
                    />
                    <input
                      type="file"
                      name="productImages"
                      class="image-input"
                      accept="image/*"
                    />
                    <div class="image-preview" style="display: none">
                      <img class="preview-img" alt="Preview" />
                    </div>
                  </div>
                  <div class="upload-img-box">
                    <img
                      src="/img/upload.png"
                      alt="Upload"
                      class="upload-placeholder"
                    />
                    <input
                      type="file"
                      name="productImages"
                      class="image-input"
                      accept="image/*"
                    />
                    <div class="image-preview" style="display: none">
                      <img class="preview-img" alt="Preview" />
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Form Actions -->
            <div class="operation-buttons">
              <button type="reset" class="btn btn-secondary" id="cancel-btn">
                <span>Clear Form</span>
              </button>
              <button type="submit" class="btn btn-primary" id="create-btn">
                <span class="checkmark">✓</span> Create Product
              </button>
            </div>

            <input name="restaurantId" class="restaurant-id" hidden />
          </form>
        </div>
      </div>
    </div>
  </div>

  <script type="text/javascript" src="/js/products.js"></script>
</body>

