                  </td>
                  <td>
                    <span class="type-badge type-classic">Classic</span>
                  </td>
                  <td>Vanilla</td>
                  <td>
                    <div class="price-container">
                      <span class="original-price">$7.99</span>
                      <span class="discount-badge">-10%</span>
                      <span class="final-price">$7.19</span>
                    </div>
                  </td>
                  <td>
                    <span class="stock-cell">80</span>
                  </td>
                  <td>
                    <select class="spec-select new-product-status">
                      <option value="PAUSE" selected>PAUSE</option>
                      <option value="PROCESS">PROCESS</option>
                      <option value="DELETE">DELETE</option>
                    </select>
                  </td>
