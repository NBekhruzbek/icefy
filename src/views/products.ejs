<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/products.css" />

<body>
  <div class="products-container">
    <!-- Navigation Menu -->
    <div class="navigation-menu">
      <ul class="nav justify-content-center">
        <li class="nav-item">
          <a class="nav-link" href="/admin/">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link active" href="/admin/product/all">Products</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/admin/user/all">Users</a>
        </li>
        <li class="nav-item user-profile-item">
          <div class="profile-wrapper">
            <img
              src="/<%= member.memberImage %>"
              alt="User Profile"
              class="profile-image"
              id="profileToggle"
            />
            <div class="profile-dropdown" id="profileDropdown">
              <div class="dropdown-header">
                <img
                  src="/<%= member.memberImage %>"
                  alt="User Profile"
                  class="dropdown-image"
                />
                <div class="user-info">
                  <p class="user-name"><%= member.memberNick %></p>
                  <p class="user-phone"><%= member.memberPhone %></p>
                </div>
              </div>
              <div class="dropdown-divider"></div>
              <a
                href="/admin/logout"
                class="dropdown-item logout-item"
                onclick="return confirm('Do you really want to logout?');"
              >
                <span class="logout-icon">🚪</span>
                <span class="logout-text">Logout</span>
              </a>
            </div>
          </div>
        </li>
      </ul>
    </div>

