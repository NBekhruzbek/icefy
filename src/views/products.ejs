<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/admin/css/products.css" />

<body>
  <div class="products-container">
    <!-- Navigation Menu -->
    <div class="navigation-menu">
      <ul class="nav justify-content-center">
        <li class="nav-item">
          <a class="nav-link" href="/admin/">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link active" href="/admin/product/all">Products</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/admin/user/all">Users</a>
        </li>
        <li class="nav-item user-profile-item">
          <div class="profile-wrapper">
            <img
              src="/<%= member.memberImage %>"
              alt="User Profile"
              class="profile-image"
              id="profileToggle"
            />
            <div class="profile-dropdown" id="profileDropdown">
              <div class="dropdown-header">
                <img
                  src="/<%= member.memberImage %>"
                  alt="User Profile"
                  class="dropdown-image"
                />
                <div class="user-info">
                  <p class="user-name"><%= member.memberNick %></p>
                  <p class="user-phone"><%= member.memberPhone %></p>
                </div>
              </div>
              <div class="dropdown-divider"></div>
              <a
                href="/admin/logout"
                class="dropdown-item logout-item"
                onclick="return confirm('Do you really want to logout?');"
              >
                <span class="logout-icon">🚪</span>
                <span class="logout-text">Logout</span>
              </a>
            </div>
          </div>
        </li>
      </ul>
    </div>

    <!-- Main Content -->
    <div class="restaurant-menu-frame">
      <div class="board">
        <!-- Products Table Section -->
        <div class="dishes-table">
          <div class="section-header">
            <h2 class="icefy-menu-text">ICEFY Menu</h2>
          </div>

          <div class="table-wrapper">
            <table class="table table-hover">
              <thead class="thead-light">
                <tr>
                  <th scope="col">No</th>
                  <th scope="col">Image</th>
                  <th scope="col">Name</th>
                  <th scope="col">Category</th>
                  <th scope="col">Size</th>
                  <th scope="col">Price</th>
                  <th scope="col">Stock</th>
                  <th scope="col">Status</th>
                </tr>
              </thead>
              <% products.map(function(value, key) { %>
              <tbody>
                <tr>
                  <td><%= key + 1 %></td>
                  <td><img class="product-image" src="/<%= value.productImages[0] %>" alt=""></td>
                  <td><span class="product-name-cell"><%= value.productName %></span></td>
                  <td>
                    <% if (value.productCategory === "CLASSIC") { %>
                      <span class="type-badge type-classic"><%= value.productCategory %></span>
                    <% } else if (value.productCategory === "PREMIUM") { %>
                      <span class="type-badge type-premium"><%= value.productCategory %></span>
                    <% } else if (value.productCategory === "LIMITED") { %>
                      <span class="type-badge type-limited"><%= value.productCategory %></span>
                    <% } else if (value.productCategory === "KIDS") { %>
                      <span class="type-badge type-kids"><%= value.productCategory %></span>
                    <% } else if (value.productCategory === "OTHER") { %>
                      <span class="type-badge type-other"><%= value.productCategory %></span>
                    <% } %>
                  </td>
                    
                  <td> <span class="product-sizee"></span><%= value.productSize %></td>
                  <td >
                    <div class="price-container">
                      <% if(!value.discountPercent){ %>
                        <span class="product-pricee">$<%= value.productPrice %></span>
                      <% } else { %>
                        <span class="original-price">$<%= value.productPrice %></span>
                        <span class="discount-badge">-<%= value.discountPercent %>%</span>
                        <span class="final-price">$<%= value.priceAfterDiscount %></span>
                      <% } %>
                    </div>
                  </td>
                  <td>
                    <span class="stock-cell"><%= value.productLeftCount %></span>
                  </td>
                  <td>
                    <select class="spec-select new-product-status" id="<%= value._id %>" onchange="setStatusBg(this)">
                      <option value="PAUSE" <%= value.productStatus === "PAUSE" ? "selected" : "" %>>PAUSE</option>
                      <option value="PROCESS" <%= value.productStatus === "PROCESS" ? "selected" : "" %>>PROCESS</option>
                      <option value="DELETE" <%= value.productStatus === "DELETE" ? "selected" : "" %>>DELETE</option>
                    </select>
                  </td>
                </tr>
              </tbody>
              <% }) %>
            </table>
          </div>
        </div>

        <!-- New Product Form Section -->
        <div class="form-section">
          <div class="section-header">
            <button class="add-new-product" id="openFormBtn">Add New Product</button>
          </div>

          <form
            onsubmit="return validateForm()"
            action="/admin/product/create"
            method="POST"
            class="icefy-container hidden"
            id="productForm"
            enctype="multipart/form-data"
          >
            <!-- Basic Information -->
            <div class="form-group">
              <h3 class="form-group-title">Basic Information</h3>

              <div class="long-input">
                <label>Product Name *</label>
                <input
                  type="text"
                  placeholder="Enter product name"
                  name="productName"
                  class="product-name"
                  required
                />
              </div>

              <div class="long-input">
                <label>Product Description</label>
                <textarea
                  name="productDesc"
                  class="product-desc"
                  placeholder="Enter product description..."
                ></textarea>
              </div>

              <input
                name="productStatus"
                value="PAUSE"
                class="product-status"
                hidden
              />
            </div>

            <!-- Pricing & Stock -->
            <div class="form-group">
              <h3 class="form-group-title">Pricing & Stock</h3>

              <div class="half-input-frame">
                <div class="half-input">
                  <label>Original Price ($) *</label>
                  <input
                    type="number"
                    placeholder="0.00"
                    name="productPrice"
                    class="product-price"
                    step="0.01"
                    required
                  />
                </div>
                <div class="half-input">
                  <label
                    >Discount (%) <span class="optional">Optional</span></label
                  >
                  <input
                    type="number"
                    placeholder="0"
                    name="discountPercent"
                    class="discount-percent"
                    min="0"
                    max="100"
                    step="0.5"
                  />
                </div>
              </div>

              <div
                class="discount-preview-box"
                id="discountPreview"
                style="display: none"
              >
                <div class="discount-preview-item">
                  <span class="preview-label">Original Price:</span>
                  <span class="preview-value" id="previewOriginalPrice"
                    >$0.00</span
                  >
                </div>
                <div class="discount-preview-item">
                  <span class="preview-label">Discount:</span>
                  <span class="preview-value discount" id="previewDiscount"
                    >0%</span
                  >
                </div>
                <div class="discount-preview-item highlight">
                  <span class="preview-label">Final Price:</span>
                  <span class="preview-value final" id="previewFinalPrice"
                    >$0.00</span
                  >
                </div>
              </div>

              <div class="half-input-frame">
                <div class="half-input">
                  <label>Stock Count *</label>
                  <input
                    type="number"
                    placeholder="0"
                    name="productLeftCount"
                    class="product-left-count"
                    required
                  />
                </div>
              </div>
            </div>

            <!-- Product Details -->
            <div class="form-group">
              <h3 class="form-group-title">Product Details</h3>

              <div class="half-input-frame">
                <div class="half-input">
                  <label>Category *</label>
                  <select
                    class="product-category"
                    name="productCategory"
                    required
                  >
                    <option value="">Select Category</option>
                    <option value="CLASSIC">Classic</option>
                    <option value="PREMIUM">Premium</option>
                    <option value="LIMITED">Limited</option>
                    <option value="KIDS">Kids</option>
                    <option value="OTHER">Other</option>
                  </select>
                </div>

                <div class="half-input">
                  <label>Flavor *</label>
                  <select class="product-flavor" name="productFlavor" required>
                    <option value="">Select Flavor</option>
                    <option value="VANILLA">Vanilla</option>
                    <option value="CHOCOLATE">Chocolate</option>
                    <option value="STRAWBERRY">Strawberry</option>
                    <option value="COOKIES_CREAM">Cookies & Cream</option>
                    <option value="MANGO">Mango</option>
                    <option value="MATCHA">Matcha</option>
                    <option value="MINT_CHOCOLATE_CHIP">
                      Mint Chocolate Chip
                    </option>
                    <option value="COFFEE">Coffee</option>
                    <option value="CARAMEL">Caramel</option>
                    <option value="YOGURT">Yogurt</option>
                  </select>
                </div>
              </div>

              <div class="half-input-frame">
                <div class="half-input">
                  <label>Size *</label>
                  <select class="product-size" name="productSize" required>
                    <option value="">Select Size</option>
                    <option value="SMALL">Small</option>
                    <option value="MEDIUM">Medium</option>
                    <option value="LARGE">Large</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Product Images -->
            <div class="form-group">
              <h3 class="form-group-title">Product Images (Up to 5)</h3>

              <div class="img-frame">
                <div class="media-frame">
                  <div class="upload-img-box">
                    <img
                      src="/admin/img/upload.png"
                      alt="Upload"
                      class="upload-placeholder 1"
                      id="image-section-1"
                    />
                    <input
                      type="file"
                      id="file"
                      name="productImages"
                      class="image-input image-one"
                      required
                      onchange="previewFileHandler(this, 1)"
                    />
                  </div>
                  <div class="upload-img-box">
                    <img
                      src="/admin/img/upload.png"
                      alt="Upload"
                      class="upload-placeholder 2"
                      id="image-section-2"
                    />
                    <input
                      type="file"
                      id="file"
                      name="productImages"
                      class="image-input image-two"
                      onchange="previewFileHandler(this, 2)"
                    />
                  </div>
                  <div class="upload-img-box">
                    <img
                      src="/admin/img/upload.png"
                      alt="Upload"
                      class="upload-placeholder 3"
                      id="image-section-3"
                    />
                    <input
                      type="file"
                      id="file"
                      name="productImages"
                      class="image-input image-three"
                      onchange="previewFileHandler(this, 3)"
                    />
                  </div>
                  <div class="upload-img-box">
                    <img
                      src="/admin/img/upload.png"
                      alt="Upload"
                      class="upload-placeholder 4"
                      id="image-section-4"
                    />
                    <input
                      type="file"
                      id="file"
                      name="productImages"
                      class="image-input image-four"
                      onchange="previewFileHandler(this, 4)"
                    />
                  </div>
                  <div class="upload-img-box">
                    <img
                      src="/admin/img/upload.png"
                      alt="Upload"
                      class="upload-placeholder 5"
                      id="image-section-5"
                    />
                    <input
                      type="file"
                      id="file"
                      name="productImages"
                      class="image-input image-five"
                      onchange="previewFileHandler(this, 5)"
                    />
                  </div>
                </div>
              </div>
            </div>

            <!-- Form Actions -->
            <div class="operation-buttons">
              <button type="reset" class="btn btn-secondary" id="cancel-btn">
                <span>Clear Form</span>
              </button>
              <button type="submit" class="btn btn-primary" id="create-btn">
                <span class="checkmark">✓</span> Create Product
              </button>
            </div>

            <input name="restaurantId" class="restaurant-id" hidden />
          </form>
        </div>
      </div>
    </div>
  </div>

  <script type="text/javascript" src="/admin/js/products.js"></script>
</body>

<%- include('includes/footer') %>
