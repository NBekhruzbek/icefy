<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/admin/css/signup.css" />

<body>
  <div class="signup-container">
    <form
      class="signup"
      onsubmit="return validateSingupForm();"
      action="/admin/signup"
      method="POST"
      enctype="multipart/form-data"
    >
      <!-- Video Container -->
      <div class="video-container">
        <video autoplay muted loop playsinline class="ice-cream-video">
          <source src="/admin/videos/signup-video.mp4" type="video/mp4" />
          Your browser doesn't support the video tag.
        </video>
      </div>

      <!-- Signup Form -->
      <div class="signup-frame">
        <div class="signup-top">
          <span>Signup</span>
          <div>Go back <a href="/admin" style="color: #6440fb">Home</a></div>
          <p>
            Already signed up?
            <a href="/admin/login" style="color: #6440fb">Login</a>
          </p>
        </div>

        <div class="sign-input-frame" style="justify-content: space-between">
          <div class="sign-up-frame">
            <label>Admin Name *</label>
            <input
              type="text"
              name="memberNick"
              class="member-nick"
              placeholder="Admin name"
              value=""
              required
            />
          </div>
          <div class="sign-up-frame">
            <label>Phone *</label>
            <input
              type="text"
              name="memberPhone"
              class="member-phone"
              placeholder="Phone"
              value=""
              required
            />
          </div>
        </div>
        <div class="sign-input-frame" style="justify-content: space-between">
          <div class="sign-up-frame">
            <label>Password *</label>
            <input
              type="password"
              name="memberPassword"
              class="member-password"
              placeholder="Password"
              value=""
              required
            />
          </div>
          <div class="sign-up-frame">
            <label>Repeat password *</label>
            <input
              type="password"
              name="confirmPassword"
              class="confirm-password"
              placeholder="Repeat password"
              value=""
              required
            />
          </div>
        </div>

        <div class="signup-input-frame">
          <div class="media-frame">
            <img class="upload-img-frame" src="/admin/img/default.png" />
            <div class="upload-container">
              <span class="media-text">Admin image</span>
              <div
                class="file-box bs3-primary preview-image"
                style="margin-top: 25px; display: flex"
              >
                <input
                  class="upload-name"
                  value="Choose image"
                  disabled="disabled"
                />
                <label for="input-file" class="file-input-label"
                  >Upload Image</label
                >
                <input
                  type="file"
                  id="input-file"
                  class="upload-hidden form-control-file member-image"
                  name="memberImage"
                />
              </div>
              <p class="thumbnail-desc">
                Please upload restaurant image.<br />
                Attention only:.jpg, .jpeg, or .png. <br />
                formats allowed!
              </p>
            </div>
          </div>
        </div>

        <input name="memberType" value="RESTAURANT" hidden />

        <button class="signup-btn btn" name="signup" type="submit">
          Signup
        </button>
      </div>
    </form>
  </div>

  <script type="text/javascript" src="/admin/js/signup.js"></script>
</body>

<%- include('includes/footer') %>
